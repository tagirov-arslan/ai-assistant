AI_ASSISTANT_INPUT_DEVICE_INDEX=
AI_ASSISTANT_STT_BACKEND=faster_whisper
AI_ASSISTANT_WHISPER_MODEL=whisper-large-v3-turbo-ct2
AI_ASSISTANT_WHISPER_DEVICE=cpu
AI_ASSISTANT_WHISPER_COMPUTE_TYPE=int8
AI_ASSISTANT_WHISPER_LANGUAGE=ru
AI_ASSISTANT_WHISPER_BEAM_SIZE=1
AI_ASSISTANT_WHISPER_VAD_FILTER=true
AI_ASSISTANT_WHISPER_INITIAL_PROMPT=
# Длительность записи команды (чтобы НЕ обрывать пользователя).
# STT_SILENCE_TIMEOUT — сколько секунд тишины ждать после фразы (по умолчанию 2.5).
# STT_PHRASE_TIME_LIMIT — максимальная длина команды в секундах (по умолчанию 20).
STT_SILENCE_TIMEOUT=2.5
STT_PHRASE_TIME_LIMIT=20
SUPERTONIC_MODEL_DIR=supertonic-3-model
SUPERTONIC_VOICE=F1
SUPERTONIC_LANG=ru
SUPERTONIC_STEPS=8
SUPERTONIC_SPEED=1.0
